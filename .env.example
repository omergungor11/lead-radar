# Prisma (SQLite)
DATABASE_URL="file:./dev.db"

# Panel girişi — tek şifre
ADMIN_PASSWORD="degistir-beni"
# Cookie imzası — `openssl rand -hex 32`
SESSION_SECRET=""

# Google Places API (New) — https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=""

# Google Maps JavaScript API — aramalar sayfasındaki harita. TARAYICIYA GİDER: Places anahtarını
# kullanmayın; ayrı anahtar oluşturup "API restrictions: Maps JavaScript API" +
# "HTTP referrers: http://localhost:3000/*" (ve canlı alan adı) ile kısıtlayın.
GOOGLE_MAPS_BROWSER_KEY=""

# 1 → anahtar gerekmez, 15 sabit mock işletme döner (geliştirme + test)
PLACES_MOCK=0
